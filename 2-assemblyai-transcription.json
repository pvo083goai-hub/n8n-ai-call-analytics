        "jsCode": "return items.map(item => {\n\n  const link = item.json.URL;\n\n  const fileId = link.match(/[-\\w]{25,}/)[0];\n\n  item.json.fileId = fileId;\n  item.json.downloadLink =\n    `https://drive.google.com/uc?export=download&id=${fileId}`;\n\n  return item;\n\n});"
