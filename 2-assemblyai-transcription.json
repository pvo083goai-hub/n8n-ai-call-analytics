    {
      "parameters": {
        "jsCode": "const transcript = $input.first().json;\n\nlet dialog = \"\";\n\n// Если есть разбивка по репликам\nif (transcript.utterances && transcript.utterances.length > 0) {\n\n  const managerKeywords = [\n    \"оператор\",\n    \"менеджер\",\n    \"можу допомогти\",\n    \"чим можу допомогти\",\n    \"добрий день\",\n    \"вітаю\",\n    \"оформлю повернення\",\n    \"ми повернемо\",\n    \"вибачте\",\n    \"перепрошую\",\n    \"дякуємо\"\n  ];\n\n  const customerKeywords = [\n    \"замовляла\",\n    \"хочу\",\n    \"незадоволена\",\n    \"доставка\",\n    \"кур'єр\",\n    \"повернення\",\n    \"гроші\",\n    \"свято\",\n    \"діти\",\n    \"проблема\",\n    \"скарга\",\n    \"чому\",\n    \"коли\"\n  ];\n\n  const scores = {};\n\n  for (const u of transcript.utterances) {\n\n    const speaker = u.speaker;\n\n    if (!scores[speaker]) {\n      scores[speaker] = {\n        manager: 0,\n        customer: 0\n      };\n    }\n\n    const text = (u.text || \"\").toLowerCase();\n\n    managerKeywords.forEach(word => {\n      if (text.includes(word)) scores[speaker].manager++;\n    });\n\n    customerKeywords.forEach(word => {\n      if (text.includes(word)) scores[speaker].customer++;\n    });\n  }\n\n  const labels = {};\n\n  Object.keys(scores).forEach(speaker => {\n\n    if (scores[speaker].manager > scores[speaker].customer) {\n      labels[speaker] = \"Менеджер\";\n    } else if (scores[speaker].customer > scores[speaker].manager) {\n      labels[speaker] = \"Клієнт\";\n    } else {\n      labels[speaker] = speaker;\n    }\n\n  });\n\n  dialog = transcript.utterances\n    .map(u => `${labels[u.speaker]}: ${u.text}`)\n    .join(\"\\n\\n\");\n\n} else {\n\n  // Если AssemblyAI не вернул utterances\n  dialog = transcript.text || \"\";\n\n}\n\nreturn [{\n  json: {\n    ...transcript,\n    dialog\n  }\n}];"
      },
