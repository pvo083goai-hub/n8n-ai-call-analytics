      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst totalCalls = rows.length;\n\nconst negativeCalls = rows.filter(\n  item => item.json.tone === \"negative\"\n).length;\n\nconst negativeCallPercent =\n  totalCalls === 0\n    ? \"0%\"\n    : Math.round((negativeCalls / totalCalls) * 100) + \"%\";\n\nreturn [\n  {\n    json: {\n      totalCalls,\n      negativeCalls,\n      negativeCallPercent\n    }\n  }\n];"
